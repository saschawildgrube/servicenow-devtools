        <api_name>x_snc_devtools.InstanceDeactivateAI</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Deactivates all (known) AI capabilities on a platform. Executing this function requires "maint" access.&#13;
WARNING: This cannot easily be undone. Use only in case of emergency!</description>
        <mobile_callable>false</mobile_callable>
        <name>InstanceDeactivateAI</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function InstanceDeactivateAI()
{
	if (IsUserMaint() == false)
	{
		LogError('InstanceDeactivateAI requires "maint" access');
		return false;
	}

	Log('InstanceDeactivateAI STARTS');

	var installer = InstallerAPI('InstanceDeactivateAI');

	return installer.Finish();
}]]></script>
