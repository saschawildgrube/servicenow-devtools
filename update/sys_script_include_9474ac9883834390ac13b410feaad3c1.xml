        <api_name>x_snc_devtools.IsStoreAppInstalled</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Returns true if the given Store App is installed on the instance, false if not.</description>
        <mobile_callable>false</mobile_callable>
        <name>IsStoreAppInstalled</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function IsStoreAppInstalled(vStoreApp)
{
	var grStoreApp = GetStoreAppRecord(vStoreApp);
	if (IsValidRecord(grStoreApp) == true)
	{
		return true;
	}
	return false;
}
]]></script>
