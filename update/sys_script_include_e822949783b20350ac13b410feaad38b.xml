        <api_name>x_snc_devtools.IsValidAppName</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Returns true if the given string is a valid application (custom or store) name, false if not.</description>
        <mobile_callable>false</mobile_callable>
        <name>IsValidAppName</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function IsValidAppName(strName)
{
	strName = GetStringValue(strName);
	if (strName == '')
	{
		return false;
	}
	if (strName.trim() != strName)
	{
		return false;
	}
	return StringCheckRegEx(
		strName,
		'^([A-Za-z\\@])([_\\-\\/A-Za-z0-9\\s]*)$');
}
]]></script>
