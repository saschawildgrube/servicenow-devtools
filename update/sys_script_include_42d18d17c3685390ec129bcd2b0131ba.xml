    <sys_script_include action="INSERT_OR_UPDATE">
        <access>public</access>
        <active>true</active>
        <api_name>x_snc_devtools.BusinessProcessGetMermaidSwimlanes</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Returns the Mermaid swimlane diagram code for the given business process object.</description>
        <mobile_callable>false</mobile_callable>
        <name>BusinessProcessGetMermaidSwimlanes</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function BusinessProcessGetMermaidSwimlanes(business_process,strDirection)
{
	if (BusinessProcessValidate(business_process,false) == false)
	{
		return false;
	}
	strDirection = GetStringValue(strDirection);
	if (strDirection == '')
	{
		strDirection = 'LR';
	}

	var strCode = '';
	strCode += 'swimlane-beta ' + strDirection + '\n';

	return strCode;
}
]]></script>
