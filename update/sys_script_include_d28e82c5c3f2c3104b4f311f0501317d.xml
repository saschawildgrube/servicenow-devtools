        <api_name>x_snc_devtools.GetWordsFromString</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Extract all words (and numbers) from a given string.</description>
        <mobile_callable>false</mobile_callable>
        <name>GetWordsFromString</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function GetWordsFromString(strInput)
{
	strInput = GetStringValue(strInput);
	strInput = strInput.trim();
	var aWords = strInput.split(/[^\p{L}\p{N}]+/u);
	if (aWords.length == 1)
	{
		if (GetStringValue(GetValue(aWords,0)) == '')
		{
			return [];
		}
	}
	return aWords;
}]]></script>
